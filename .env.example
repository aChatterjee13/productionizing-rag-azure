####################################################################################
# productionizing-rag-azure — environment template
#
#   cp .env.example .env      (or: make setup)
#
# Every variable is a field on ragcore.settings.Settings, prefixed RAG_. Defaults in
# code target local docker-compose; the commented values below each group show the
# Azure-shaped form for dev/staging/production. Secrets come from Azure Key Vault in
# deployed environments — never commit a filled-in .env.
####################################################################################

# ---------------------------------------------------------------------- platform
# local | dev | staging | production
RAG_ENV=local
RAG_SERVICE_NAME=rag-platform
RAG_LOG_LEVEL=INFO
# JSON logs are required for Log Analytics; set false for readable local output.
RAG_LOG_JSON=false
RAG_DEBUG=false

# ------------------------------------------------------------------------ qdrant
RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_URL=https://rag-qdrant-prod.westeurope.azurecontainerapps.io
RAG_QDRANT_API_KEY=
RAG_QDRANT_PREFER_GRPC=false
RAG_QDRANT_GRPC_PORT=6334
RAG_QDRANT_TIMEOUT_SECONDS=30
RAG_QDRANT_CHUNKS_COLLECTION=rag_chunks
RAG_QDRANT_MEMORIES_COLLECTION=rag_memories
RAG_QDRANT_CACHE_COLLECTION=rag_semantic_cache
# m=0 on the global index so tenant-scoped search uses the payload partition index.
RAG_QDRANT_HNSW_M=0
RAG_QDRANT_HNSW_PAYLOAD_M=16
RAG_QDRANT_HNSW_EF_CONSTRUCT=128
RAG_QDRANT_UPSERT_BATCH_SIZE=64

# ---------------------------------------------------------------------- postgres
RAG_POSTGRES_HOST=localhost
# RAG_POSTGRES_HOST=rag-pg-prod.postgres.database.azure.com
RAG_POSTGRES_PORT=5432
RAG_POSTGRES_USER=rag
# Azure Flexible Server usually wants the bare user name (no @server suffix).
RAG_POSTGRES_PASSWORD=rag
RAG_POSTGRES_DB=rag
# Azure Database for PostgreSQL requires 'require'.
RAG_POSTGRES_SSLMODE=prefer
RAG_POSTGRES_POOL_SIZE=10
RAG_POSTGRES_MAX_OVERFLOW=10
RAG_POSTGRES_POOL_RECYCLE_SECONDS=1800
RAG_POSTGRES_STATEMENT_TIMEOUT_MS=30000
RAG_POSTGRES_ECHO=false
# Overrides every postgres_* value above. Tests point this at sqlite+aiosqlite.
# RAG_DATABASE_URL_OVERRIDE=

# ------------------------------------------------------------------------- redis
RAG_REDIS_URL=redis://localhost:6379/0
# RAG_REDIS_URL=rediss://rag-redis-prod.redis.cache.windows.net:6380/0?password=...
RAG_REDIS_ENABLED=true
RAG_REDIS_TTL_SECONDS=3600
RAG_REDIS_LOCK_TIMEOUT_SECONDS=300
# Session-window key prefix. Keys are <prefix><tenant_id>:<session_id> — tenant first.
RAG_REDIS_SESSION_PREFIX=rag:session:

# --------------------------------------------------------------------- anthropic
# Omit to let the SDK resolve ANTHROPIC_API_KEY or an `ant auth login` profile.
RAG_ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Exact model ids, no date suffix.
RAG_ANTHROPIC_MODEL_MAIN=claude-opus-5
RAG_ANTHROPIC_MODEL_FAST=claude-sonnet-5
RAG_ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
# low | medium | high | xhigh | max — nested inside output_config by the client.
RAG_ANTHROPIC_EFFORT=high
RAG_ANTHROPIC_EFFORT_FAST=medium
RAG_ANTHROPIC_EFFORT_CHEAP=low
# Adaptive thinking. On claude-opus-5 thinking is on by default; disabling it is only
# valid at effort 'high' or lower.
RAG_ANTHROPIC_THINKING=true
# 'omitted' is the API default and yields empty thinking text (reads as a stall).
RAG_ANTHROPIC_THINKING_DISPLAY=summarized
RAG_ANTHROPIC_MAX_TOKENS=16000
RAG_ANTHROPIC_MAX_TOKENS_STREAMING=64000
RAG_ANTHROPIC_MAX_TOKENS_CLASSIFY=256
RAG_ANTHROPIC_MAX_TOKENS_STRUCTURED=4000
RAG_ANTHROPIC_CACHE_SYSTEM=true
RAG_ANTHROPIC_FALLBACKS_ENABLED=true
RAG_ANTHROPIC_MAX_RETRIES=4
RAG_ANTHROPIC_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------- entra
RAG_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
RAG_ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111
# Set when tokens carry the URI audience form instead of the bare client id.
# RAG_ENTRA_AUDIENCE=api://11111111-1111-1111-1111-111111111111
RAG_ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
RAG_ENTRA_JWKS_CACHE_SECONDS=3600
RAG_ENTRA_ADMIN_ROLE=rag.admin
RAG_ENTRA_LEEWAY_SECONDS=60
# LOCAL ONLY. Accepts an unsigned x-dev-principal header. The API refuses to start
# with this enabled when RAG_ENV=production.
RAG_ENTRA_DEV_MODE=true
RAG_ENTRA_DEV_PRINCIPAL_HEADER=x-dev-principal
# App role -> clearance ceiling. The strongest matching rule across roles and groups
# wins, so rag.admin alongside rag.public still yields restricted.
RAG_ENTRA_CLEARANCE_ROLES={"rag.admin":"restricted","rag.restricted":"restricted","rag.confidential":"confidential","rag.internal":"internal","rag.public":"public"}
# Entra group object id -> clearance ceiling. Empty: group ids are deployment-specific.
RAG_ENTRA_CLEARANCE_GROUPS={}
# Ceiling for a caller matching no role or group rule.
RAG_ENTRA_DEFAULT_CLASSIFICATION=internal
# Accept the v1.0 issuer https://sts.windows.net/{tid}/ alongside the v2.0 one.
RAG_ENTRA_ACCEPT_V1_ISSUER=true
# Optional 'scp' every caller must present; unset (the default) disables the check.
# RAG_ENTRA_REQUIRED_SCOPE=access_as_user
# Reject a token whose 'tid' is not the pinned directory.
RAG_ENTRA_PIN_TENANT=true
# Floor between JWKS refetches triggered by an unknown 'kid' — a forged-kid DoS guard.
RAG_ENTRA_JWKS_REFRESH_MIN_SECONDS=60
# Per-request timeout for the JWKS fetch.
RAG_ENTRA_JWKS_TIMEOUT_SECONDS=10
# Resolve a group-overage claim through Graph. Off means no groups, which fails closed.
RAG_ENTRA_GROUP_OVERAGE_LOOKUP=true
# TTL for a resolved group-overage lookup.
RAG_ENTRA_GROUP_CACHE_SECONDS=900
# Page size for the Graph transitive-group query.
RAG_ENTRA_GROUP_PAGE_SIZE=999
# Per-request timeout for Microsoft Graph calls.
RAG_ENTRA_GROUP_LOOKUP_TIMEOUT_SECONDS=10
# Graph path relative to RAG_AZURE_GRAPH_BASE_URL; '/me/' becomes '/users/{oid}/'.
RAG_ENTRA_GROUP_LOOKUP_PATH=/me/transitiveMemberOf/microsoft.graph.group
# Client-credentials secret for Graph, used only when managed identity is unavailable.
# Default unset. Source it from Key Vault; never commit one.
# RAG_ENTRA_CLIENT_SECRET=
# Azure IMDS endpoint, the managed-identity token source.
RAG_ENTRA_MANAGED_IDENTITY_ENDPOINT=http://169.254.169.254/metadata/identity/oauth2/token
# API version sent to the IMDS token endpoint.
RAG_ENTRA_MANAGED_IDENTITY_API_VERSION=2018-02-01
# Refresh a Graph token this many seconds before it actually expires.
RAG_ENTRA_GRAPH_TOKEN_SKEW_SECONDS=60

# ---------------------------------------------------------------------- langfuse
RAG_LANGFUSE_ENABLED=false
RAG_LANGFUSE_HOST=http://localhost:3000
# RAG_LANGFUSE_HOST=https://rag-langfuse-prod.westeurope.azurecontainerapps.io
RAG_LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000000000000000
RAG_LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000000000000000
RAG_LANGFUSE_SAMPLE_RATE=1.0
RAG_LANGFUSE_DEBUG=false
# RAG_LANGFUSE_RELEASE=$GIT_SHA

# ------------------------------------------------------------------------- azure
RAG_AZURE_BLOB_ACCOUNT_URL=https://ragstorprod.blob.core.windows.net
RAG_AZURE_BLOB_CONTAINER=rag-documents
RAG_AZURE_BLOB_RAW_CONTAINER=rag-raw
# Local only (Azurite / dev storage). Prefer managed identity everywhere else.
# RAG_AZURE_BLOB_CONNECTION_STRING=
RAG_AZURE_KEY_VAULT_URL=https://rag-kv-prod.vault.azure.net/
RAG_AZURE_USE_MANAGED_IDENTITY=true
# Set only for a user-assigned managed identity.
# RAG_AZURE_CLIENT_ID=22222222-2222-2222-2222-222222222222
RAG_AZURE_GRAPH_SCOPE=https://graph.microsoft.com/.default
RAG_AZURE_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
RAG_AZURE_STORAGE_QUEUE_NAME=rag-ingest
# RAG_AZURE_LOG_ANALYTICS_WORKSPACE_ID=33333333-3333-3333-3333-333333333333

# --------------------------------------------------------------------- embedding
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_SPARSE_MODEL=Qdrant/bm25
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_CACHE_DIR=./.cache/fastembed
RAG_EMBEDDING_MAX_CHARS=8000

# ------------------------------------------------------------------------ rerank
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=Xenova/bge-reranker-v2-m3
RAG_RERANK_TOP_N=8
RAG_RERANK_CANDIDATE_LIMIT=50
RAG_RERANK_BATCH_SIZE=16

# --------------------------------------------------------------------- retrieval
RAG_RETRIEVAL_TOP_N=8
RAG_RETRIEVAL_LIMIT=30
RAG_RETRIEVAL_PREFETCH_LIMIT=60
# rrf | dbsf — fused server-side by the Qdrant Query API, never in Python.
RAG_RETRIEVAL_FUSION=rrf
RAG_RETRIEVAL_MMR_ENABLED=true
RAG_RETRIEVAL_MMR_LAMBDA=0.7
RAG_RETRIEVAL_MAX_PER_DOCUMENT=3
RAG_RETRIEVAL_SNIPPET_CHARS=1200
# Divisor mapping a server-side fusion score onto [0,1]. RRF reference; ~2.0 for dbsf.
RAG_RETRIEVAL_FUSION_SCORE_SCALE=0.05
# Probes (rewritten query, sub-questions, HyDE passage) embedded and searched at once.
RAG_RETRIEVAL_QUERY_CONCURRENCY=4
# Re-embed a candidate locally when Qdrant did not return its dense vector.
RAG_RETRIEVAL_MMR_EMBED_FALLBACK=true

# -------------------------------------------------------------- query transform
RAG_QT_ENABLED=true
RAG_QT_MAX_SUBQUERIES=3
RAG_QT_HYDE_ENABLED=true
RAG_QT_REWRITE_ENABLED=true
RAG_QT_HISTORY_TURNS=6
# At or below this many words a query is 'sparse' — the case HyDE exists for.
RAG_QT_HYDE_MAX_QUERY_WORDS=12

# -------------------------------------------------------------------- citations
# Similarity a paraphrase must reach against its best-matching window of the chunk.
RAG_CITATION_FUZZY_THRESHOLD=0.55
# Similarity an explicitly quoted literal must reach — a near-miss is a fabrication.
RAG_CITATION_QUOTE_MIN_RATIO=0.9
# Content-token recall that may stand in for character similarity on a paraphrase.
RAG_CITATION_TOKEN_RECALL_THRESHOLD=0.6
# Every multi-digit number a cited sentence asserts must occur in the cited chunk.
RAG_CITATION_NUMBER_CHECK=true
# Below this a span borrows the preceding sentence before it is verified.
RAG_CITATION_MIN_SPAN_CHARS=12
# Cap on the span compared against a chunk, bounding verification cost.
RAG_CITATION_MAX_SPAN_CHARS=600
# Sentence length at which a sentence counts as a factual claim for coverage.
RAG_CITATION_MIN_CLAIM_WORDS=5
# Claim coverage separating a 'grounded' verdict from 'partial'.
RAG_CITATION_MIN_COVERAGE=0.5
# Rare tokens used to anchor the fuzzy window search inside a chunk.
RAG_CITATION_ANCHOR_TOKENS=3
# Upper bound on candidate windows scored per span.
RAG_CITATION_MAX_WINDOWS=24
# Remove [n] markers from the answer when no citation survived for them.
RAG_CITATION_STRIP_UNRESOLVED_MARKERS=true

# ----------------------------------------------------------------------- context
RAG_CONTEXT_BUDGET_TOKENS=120000
RAG_CONTEXT_RESERVE_OUTPUT_TOKENS=16000
# Compaction is proactive: it fires at this fraction of budget, not only on overflow.
RAG_CONTEXT_COMPACT_AT_RATIO=0.75
RAG_CONTEXT_MAX_HISTORY_TURNS=20
RAG_CONTEXT_MIN_LIVE_TURNS=4
RAG_CONTEXT_TOOL_RESULT_TTL_TURNS=3
RAG_CONTEXT_SUMMARY_MAX_TOKENS=1200
RAG_CONTEXT_RETRIEVED_BUDGET_RATIO=0.55
RAG_CONTEXT_MEMORY_BUDGET_RATIO=0.08
# Periodic suppression: compaction fires every N turns even with budget to spare.
RAG_CONTEXT_COMPACT_EVERY_N_TURNS=6
# Parallel count_tokens measurements during exact fitting.
RAG_CONTEXT_TOKEN_COUNT_CONCURRENCY=8
# Bound on the token-count memo, in entries. Keyed by digest, never by content.
RAG_CONTEXT_TOKEN_CACHE_ENTRIES=4096
# Shed passes allowed before the prompt is stripped to system + question.
RAG_CONTEXT_FIT_MAX_PASSES=3
# Retrieved chunks kept even under extreme pressure, when any were retrieved.
RAG_CONTEXT_MIN_RETRIEVED_CHUNKS=1
# Marginal-value multiplier for a near-duplicate chunk: it is shed first.
RAG_CONTEXT_DUPLICATE_PENALTY=0.35
# Place a second cache_control breakpoint at the end of the stable history prefix.
RAG_CONTEXT_CACHE_HISTORY_BREAKPOINT=true
# Minimum measured history tokens before that breakpoint is worth writing (API min 512).
RAG_CONTEXT_CACHE_HISTORY_MIN_TOKENS=1024

# ------------------------------------------------------------------------ memory
RAG_MEMORY_ENABLED=true
RAG_MEMORY_TOP_K=6
RAG_MEMORY_MIN_SALIENCE=0.25
RAG_MEMORY_SALIENCE_DECAY_PER_DAY=0.01
RAG_MEMORY_SALIENCE_BOOST_ON_HIT=0.05
RAG_MEMORY_MAX_PER_USER=500
RAG_MEMORY_TTL_DAYS=365
RAG_MEMORY_EXTRACT_ENABLED=true
RAG_MEMORY_CACHE_ENABLED=true
# A cache hit needs this cosine similarity AND an exact filter_fingerprint match.
RAG_MEMORY_CACHE_THRESHOLD=0.94
RAG_MEMORY_CACHE_TTL_SECONDS=86400
RAG_MEMORY_PROFILE_REFRESH_TURNS=10
# Cache entries kept per (tenant, filter_fingerprint) bucket before LRU-ish eviction.
RAG_MEMORY_CACHE_MAX_ENTRIES=500
# Memories scanned per consolidation pass, per user.
RAG_MEMORY_CONSOLIDATE_BATCH_SIZE=200
# Candidate oversampling factor for salience-weighted recall.
RAG_MEMORY_RECALL_OVERSAMPLE=4
# Similarity vs decayed salience when ranking recall: 1.0 similarity, 0.0 salience.
RAG_MEMORY_RECALL_SIMILARITY_WEIGHT=0.7
# Memories required before the rolling profile is regenerated by MODEL_FAST.
RAG_MEMORY_PROFILE_MIN_MEMORIES=3

# -------------------------------------------------------------------- guardrails
RAG_GUARDRAIL_INPUT_MAX_CHARS=16000
RAG_GUARDRAIL_INJECTION_ENABLED=true
RAG_GUARDRAIL_INJECTION_BLOCK_THRESHOLD=0.8
RAG_GUARDRAIL_INJECTION_WARN_THRESHOLD=0.5
RAG_GUARDRAIL_OOD_ENABLED=true
RAG_GUARDRAIL_OOD_MIN_SCORE=0.35
RAG_GUARDRAIL_MIN_GROUNDEDNESS=0.6
RAG_GUARDRAIL_CONTRADICTION_ENABLED=true
RAG_GUARDRAIL_CONTRADICTION_MIN_SIMILARITY=0.82
RAG_GUARDRAIL_CONTRADICTION_RECENCY_DAYS=180
RAG_GUARDRAIL_OUTPUT_PII_SCAN=true
RAG_GUARDRAIL_ENFORCE_CLASSIFICATION_ON_OUTPUT=true
# --- stage 1, input guard
# Below this many characters the turn is refused with 'clarify'.
RAG_GUARDRAIL_INPUT_MIN_CHARS=1
# Truncate rather than refuse a turn over RAG_GUARDRAIL_INPUT_MAX_CHARS.
RAG_GUARDRAIL_INPUT_TRUNCATE=false
# NFKC-normalise and strip invisible characters before scanning.
RAG_GUARDRAIL_INPUT_NORMALISE_UNICODE=true
# Entity types masked out of the prompt text as well as the persisted text.
RAG_GUARDRAIL_INPUT_CREDENTIAL_ENTITIES=["API_KEY","JWT"]
# Run the dependency-free language guess on the user turn.
RAG_GUARDRAIL_LANGUAGE_DETECT_ENABLED=true
# Below this confidence the language policy is not enforced.
RAG_GUARDRAIL_LANGUAGE_MIN_CONFIDENCE=0.35
# Permitted turn languages; empty means all. Outside the list warns, never blocks.
RAG_GUARDRAIL_ALLOWED_LANGUAGES=[]
# --- stages 1 and 5, prompt injection
# Scan retrieved chunk text for indirect injection (the threat that matters).
RAG_GUARDRAIL_INJECTION_SCAN_RETRIEVED=true
# Quarantine threshold for retrieved text — must not exceed the user-turn threshold.
RAG_GUARDRAIL_INJECTION_RETRIEVED_BLOCK_THRESHOLD=0.5
# Drop a flagged chunk; false keeps it and only warns.
RAG_GUARDRAIL_INJECTION_QUARANTINE_RETRIEVED=true
# Cap on characters inspected per passage by the injection scan.
RAG_GUARDRAIL_INJECTION_MAX_SCAN_CHARS=20000
# Optional MODEL_CHEAP adjudication of a borderline injection score.
RAG_GUARDRAIL_INJECTION_CLASSIFIER_ENABLED=false
# Score multiplier applied when that classifier says 'benign'.
RAG_GUARDRAIL_INJECTION_CLASSIFIER_BENIGN_FACTOR=0.5
# --- stage 6, out-of-domain gate
# Mean top-k relevance floor.
RAG_GUARDRAIL_OOD_MEAN_SCORE_MIN=0.2
# Fewer surviving candidates than this is automatically out of domain.
RAG_GUARDRAIL_OOD_MIN_CANDIDATES=1
# Enable score-distribution collapse detection.
RAG_GUARDRAIL_OOD_COLLAPSE_ENABLED=true
# Window of scores the collapse test looks at.
RAG_GUARDRAIL_OOD_COLLAPSE_TOP_K=5
# Max-minus-min within that window at or below which the distribution is collapsed.
RAG_GUARDRAIL_OOD_COLLAPSE_SPREAD=0.05
# Collapse only counts when the best score is at or below this.
RAG_GUARDRAIL_OOD_COLLAPSE_MAX_SCORE=0.55
# Optional MODEL_CHEAP adjudication when the OOD signals disagree.
RAG_GUARDRAIL_OOD_CLASSIFIER_ENABLED=false
# Chunks scrolled per tenant to build the domain-coverage summary.
RAG_GUARDRAIL_OOD_COVERAGE_SAMPLE=512
# TTL for the per-tenant coverage cache.
RAG_GUARDRAIL_OOD_COVERAGE_TTL_SECONDS=900
# Facet values listed per refusal message.
RAG_GUARDRAIL_OOD_COVERAGE_MAX_ITEMS=8
# Phrase the refusal with MODEL_FAST instead of the deterministic template.
RAG_GUARDRAIL_OOD_LLM_REFUSAL=false
# --- stage 7, contradiction
# Below this many retrieved chunks stage 7 is skipped entirely.
RAG_GUARDRAIL_CONTRADICTION_MIN_CHUNKS=2
# Claim clusters kept for adjudication.
RAG_GUARDRAIL_CONTRADICTION_MAX_CLUSTERS=6
# Cross-document pairs adjudicated per turn — the model-call budget.
RAG_GUARDRAIL_CONTRADICTION_MAX_PAIRS=4
# Use the structured MODEL_MAIN contradiction detector.
RAG_GUARDRAIL_CONTRADICTION_LLM_ENABLED=true
# Passage length sent to the adjudicator.
RAG_GUARDRAIL_CONTRADICTION_SNIPPET_CHARS=600
# --- stage 12, output guard
# Hard floor under RAG_GUARDRAIL_MIN_GROUNDEDNESS: below it the answer is withheld.
RAG_GUARDRAIL_OUTPUT_BLOCK_BELOW_GROUNDEDNESS=0.2
# Verbatim overlap with an over-clearance chunk treated as a leak.
RAG_GUARDRAIL_OUTPUT_LEAK_SPAN_CHARS=60
# Entity types not redacted on egress: dates and office names are policy content.
RAG_GUARDRAIL_OUTPUT_PII_IGNORE_ENTITIES=["DATE_TIME","LOCATION"]
# Assess the quality of a refusal before emitting it.
RAG_GUARDRAIL_REFUSAL_CHECK_ENABLED=true
# Shorter than this, a refusal is reported as bare.
RAG_GUARDRAIL_REFUSAL_MIN_CHARS=40

# --------------------------------------------------------------------------- pii
RAG_PII_ENABLED=true
# Presidio is an optional extra (uv sync --extra pii). Without it, ragcore.pii falls
# back to the regex-only recogniser set and logs a warning — it never fails to import.
RAG_PII_USE_PRESIDIO=true
RAG_PII_LANGUAGE=en
RAG_PII_SCORE_THRESHOLD=0.5
# mask -> <EMAIL_ADDRESS>; hash -> stable HMAC (joins still work); partial -> last 4.
RAG_PII_REDACTION_MODE=mask
RAG_PII_HASH_SECRET=change-me-pii-hmac-secret
RAG_PII_PARTIAL_KEEP_CHARS=4
RAG_PII_LLM_VERIFY_ENABLED=false
RAG_PII_BLOCK_ON_EGRESS=false

# ------------------------------------------------------------------------ dedupe
RAG_DEDUPE_ENABLED=true
RAG_DEDUPE_SIMHASH_SHINGLE=4
RAG_DEDUPE_MAX_DISTANCE=3
RAG_DEDUPE_MIN_CHUNK_CHARS=64

# ---------------------------------------------------------------------- chunking
RAG_CHUNK_TARGET_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_CHUNK_MIN_TOKENS=64
RAG_CHUNK_MAX_TOKENS=1024
RAG_CHUNK_RESPECT_HEADINGS=true
RAG_CHUNK_CONTEXTUAL_HEADER_ENABLED=true
RAG_CHUNK_SUMMARY_ENABLED=false

# --------------------------------------------------------------------- tool loop
RAG_TOOL_ENABLED=true
RAG_TOOL_MAX_ITERATIONS=6
RAG_TOOL_TIMEOUT_SECONDS=20
RAG_TOOL_MAX_RESULT_CHARS=8000
# RAG_TOOL_REGISTRY_PATH=./config/tools.yaml
RAG_TOOL_MCP_ENABLED=false
RAG_TOOL_MCP_BETA_FLAG=mcp-client-2025-11-20
# Refused when RAG_ENV=production.
RAG_TOOL_ALLOW_INSECURE_HTTP=false

# --------------------------------------------------------------------- ingestion
RAG_INGEST_ENABLED=true
# Six-field NCRONTAB as Azure Functions requires: sec min hour day month dow.
# Default 02:30 daily — a delta refresh outside working hours.
RAG_INGEST_CRON=0 30 2 * * *
RAG_INGEST_TIMEZONE=UTC
# RAG_INGEST_TIMEZONE=Europe/Berlin
RAG_INGEST_WORKING_HOURS_START=8
RAG_INGEST_WORKING_HOURS_END=18
# Monday=0 ... Sunday=6. JSON list.
RAG_INGEST_WORKING_DAYS=[0,1,2,3,4]
# A scheduled run inside working hours refuses to start unless this is true.
RAG_INGEST_FORCE=false
RAG_INGEST_MAX_PARALLEL_DOCS=8
RAG_INGEST_BATCH_SIZE=32
RAG_INGEST_MAX_DOCUMENT_BYTES=26214400
RAG_INGEST_DELETE_MISSING=true
RAG_INGEST_REINDEX_ON_ACL_CHANGE=true
RAG_INGEST_HTTP_USER_AGENT=productionizing-rag-azure-crawler/0.1
RAG_INGEST_HTTP_MAX_PAGES=500
RAG_INGEST_HTTP_TIMEOUT_SECONDS=20
RAG_INGEST_HTTP_CONCURRENCY=4
RAG_INGEST_SQL_BATCH_SIZE=500
RAG_INGEST_MANIFEST_CONTAINER=rag-manifests
RAG_INGEST_RETRY_ATTEMPTS=3
RAG_INGEST_LOCAL_ROOT=./data/documents
# HTTP trigger of the ingestion Function App. Default unset: POST /admin/ingest/trigger
# then runs the crawl as a local background task instead of dispatching.
# RAG_INGEST_FUNCTION_URL=https://rag-ingest.azurewebsites.net/api/ingest/trigger
# Functions host key sent as x-functions-key. Default unset (anonymous trigger).
# RAG_INGEST_FUNCTION_KEY=

# -------------------------------------------------------------------- evaluation
RAG_EVAL_ENABLED=true
RAG_EVAL_GOLDEN_PATH=services/eval/golden/golden_set.yaml
RAG_EVAL_MAX_CONCURRENCY=4
RAG_EVAL_JUDGE_MODEL=claude-sonnet-5
RAG_EVAL_SIMILARITY_MODEL=BAAI/bge-m3
RAG_EVAL_GATE_ENABLED=true
RAG_EVAL_MIN_FAITHFULNESS=0.8
RAG_EVAL_MIN_ANSWER_RELEVANCY=0.75
RAG_EVAL_MIN_CONTEXT_PRECISION=0.7
RAG_EVAL_MIN_CONTEXT_RECALL=0.7
RAG_EVAL_MIN_ANSWER_CORRECTNESS=0.7
RAG_EVAL_MIN_SEMANTIC_SIMILARITY=0.8
RAG_EVAL_MIN_CITATION_VALIDITY=0.9
# Zero tolerance: any cross-tenant or over-clearance chunk fails the gate.
RAG_EVAL_MAX_ACL_LEAK=0.0
RAG_EVAL_MIN_REFUSAL_CORRECT=0.9
RAG_EVAL_MAX_LATENCY_MS=20000
# RAG_EVAL_SAMPLE_SIZE=10
# module:attribute of the coroutine one golden item runs through. The default drives
# the real orchestrator through all thirteen stages.
RAG_EVAL_PIPELINE_TARGET=eval.harness:run_turn
# Persona file, resolved relative to the repository root.
RAG_EVAL_PERSONAS_PATH=services/eval/golden/personas.yaml
# Where run JSON, markdown and HTML land. CI uploads this directory.
RAG_EVAL_REPORT_DIR=services/eval/reports
# Wall-clock ceiling for one golden item.
RAG_EVAL_ITEM_TIMEOUT_SECONDS=300
# Write eval_runs / eval_results rows. A database failure degrades to a warning.
RAG_EVAL_PERSIST_RESULTS=true
# Tenant on the run row. Default unset: the dominant tenant of the selection.
# RAG_EVAL_RUN_TENANT_ID=
# Skip rather than fail a tool_required item whose tool is not registered.
RAG_EVAL_SKIP_UNREGISTERED_TOOLS=true
# Run tool_required items naming a REST/MCP tool. Built-in tools always run.
RAG_EVAL_TOOL_REQUIRED_LIVE=false
# Use the RAGAS package for the LLM-only metrics when it imports cleanly.
RAG_EVAL_RAGAS_ENABLED=true
# output_config.effort for every judge call.
RAG_EVAL_JUDGE_EFFORT=medium
# Questions generated from the answer for the native answer-relevancy metric.
RAG_EVAL_RELEVANCY_PROBE_QUESTIONS=3
# Answer-correctness weighting. The two weights must sum to 1.0.
RAG_EVAL_CORRECTNESS_F1_WEIGHT=0.75
RAG_EVAL_CORRECTNESS_SIMILARITY_WEIGHT=0.25
# Judge prompt budget: contexts per call and characters per context.
RAG_EVAL_JUDGE_MAX_CONTEXTS=12
RAG_EVAL_JUDGE_MAX_CONTEXT_CHARS=4000
# Hard floors. RAG_EVAL_MAX_ACL_LEAK / _MIN_REFUSAL_CORRECT may tighten, never loosen.
RAG_EVAL_HARD_MIN_ACL_LEAK=1.0
RAG_EVAL_HARD_MIN_REFUSAL_CORRECT=0.95
# Soft floor for tool_correct — lenient until the registry points at live backends.
RAG_EVAL_MIN_TOOL_CORRECT=0.5
# Aggregate floor for expected-document retrieval recall.
RAG_EVAL_MIN_RETRIEVAL_RECALL=0.7
# A drop larger than this is a regression; below it, judge noise.
RAG_EVAL_REGRESSION_TOLERANCE=0.02
# Worst-performing items shown in full, with their trace ids.
RAG_EVAL_REPORT_WORST_ITEMS=10
# Characters of the emitted answer stored on a result.
RAG_EVAL_REPORT_ANSWER_CHARS=600
# Prefix for every Langfuse score name pushed by the harness.
RAG_EVAL_SCORE_PREFIX=eval.

# --------------------------------------------------------------------------- api
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
RAG_API_PREFIX=/api/v1
RAG_API_CORS_ORIGINS=["http://localhost:5173"]
RAG_API_REQUEST_TIMEOUT_SECONDS=300
RAG_API_MAX_UPLOAD_BYTES=26214400
RAG_API_RATE_LIMIT_PER_MINUTE=60
RAG_API_SSE_KEEPALIVE_SECONDS=15
RAG_API_METRICS_ENABLED=true
# Request-correlation headers, echoed on every response and bound into structlog.
RAG_API_REQUEST_ID_HEADER=x-request-id
RAG_API_TRACE_ID_HEADER=x-trace-id
# CORS. The web app reads the correlation headers, so they must be exposed.
RAG_API_CORS_ALLOW_CREDENTIALS=true
RAG_API_CORS_ALLOW_HEADERS=["*"]
RAG_API_CORS_EXPOSE_HEADERS=["x-request-id","x-trace-id","retry-after"]
# Pre-flight cache lifetime.
RAG_API_CORS_MAX_AGE_SECONDS=600
# Below this, compression costs more than it saves. SSE is never compressed.
RAG_API_GZIP_MIN_BYTES=1024
# Enforce the per-principal Redis rate limit.
RAG_API_RATE_LIMIT_ENABLED=true
# Bucket depth above RAG_API_RATE_LIMIT_PER_MINUTE.
RAG_API_RATE_LIMIT_BURST=20
# Redis key prefix; keys are <prefix><tenant_id>:<user_id> — tenant first.
RAG_API_RATE_LIMIT_PREFIX=rag:ratelimit:
# The one retry: hint sent at the start of an SSE stream, in milliseconds.
RAG_API_SSE_RETRY_MS=2000
# Comment heartbeat text sent every RAG_API_SSE_KEEPALIVE_SECONDS.
RAG_API_SSE_HEARTBEAT_COMMENT=heartbeat
# Base URI for RFC 7807 problem 'type' members.
RAG_API_PROBLEM_TYPE_BASE=https://productionizing-rag-azure.dev/problems
# Serve /docs, /redoc and /openapi.json. Additionally forced off in production.
RAG_API_DOCS_ENABLED=true
# Default and hard-ceiling 'limit' on every list endpoint.
RAG_API_DEFAULT_PAGE_SIZE=50
RAG_API_MAX_PAGE_SIZE=200
# Load the FastEmbed dense/sparse/rerank models during startup. Off boots CI faster.
RAG_API_WARM_MODELS=true
# Create the Qdrant collections during startup. Idempotent.
RAG_API_ENSURE_COLLECTIONS=true
# Seconds the readiness probe waits on each dependency.
RAG_API_READINESS_TIMEOUT_SECONDS=5

# --------------------------------------------------------------------------- web
# Consumed by the Vite build, not by ragcore.settings.
VITE_API_BASE_URL=http://localhost:8000
VITE_ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user
VITE_DEV_MODE=true
