# --------------------------------------------------------------- model caches
# FastEmbed downloads bge-m3 and the reranker here; hundreds of MB.
.cache/
.fastembed_cache/
# Anchored to the repo root on purpose. An unanchored `models/` matches *any*
# directory of that name at any depth, which silently excluded the whole of
# packages/ragcore/ragcore/models/ — the model layer — from every commit.
/models/
*.onnx

