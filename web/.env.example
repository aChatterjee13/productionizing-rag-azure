# ---------------------------------------------------------------------------
# web/.env.example — copy to web/.env.local for local development.
#
# Only variables prefixed VITE_ are exposed to the browser bundle. Never put a
# client secret here: the app uses the PKCE authorization-code flow, which is
# public-client by design and needs no secret.
#
# The names below match the `# web` block of the repository-root .env.example.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------- API
# Leave empty to issue same-origin requests (the Vite dev server proxies /api to
# VITE_API_PROXY_TARGET, and in production nginx serves the SPA next to the API).
# docker-compose sets this to http://localhost:8000 as a build arg.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8000
# Must match ragcore settings `api_prefix`.
VITE_API_PREFIX=/api/v1
# Milliseconds. Non-streaming requests only; the chat stream is not timed out here.
VITE_API_TIMEOUT_MS=30000
# Milliseconds of silence on the SSE stream before it is treated as dead.
VITE_STREAM_IDLE_TIMEOUT_MS=120000
# Transport retries for a chat stream that dies before the first token arrives.
VITE_STREAM_MAX_RETRIES=2
VITE_STREAM_RETRY_BASE_MS=500
# Page size for list endpoints (sessions, documents, memories, runs).
VITE_PAGE_SIZE=50
# Budget utilisation at which the context meter warns about imminent compaction.
# Keep in step with ragcore `context_compact_at_ratio`.
VITE_CONTEXT_WARN_RATIO=0.75

# ------------------------------------------------------------- dev server
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# ----------------------------------------------------------- Entra ID (MSAL)
# App registration (SPA platform) client id and the directory tenant id.
VITE_ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# Scope exposed by the API app registration; the access token audience.
VITE_ENTRA_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user
# Must be registered as a SPA redirect URI. Defaults to the app origin.
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
# sessionStorage (default, safer) or localStorage (survives a tab close).
VITE_ENTRA_CACHE_LOCATION=sessionStorage
# Set true only behind a corporate proxy that strips storage in iframes.
VITE_ENTRA_STORE_AUTH_STATE_IN_COOKIE=false

# ------------------------------------------------------------------ dev mode
# Mirrors RAG_ENTRA_DEV_MODE on the API: skips MSAL entirely and sends an
# unsigned principal header instead of a bearer token. NEVER enable in production;
# the API refuses to start with dev mode on when RAG_ENV=production.
VITE_DEV_MODE=true
# Must equal RAG_ENTRA_DEV_PRINCIPAL_HEADER.
VITE_DEV_PRINCIPAL_HEADER=x-dev-principal
# JSON Principal sent in that header when dev mode is on.
VITE_DEV_PRINCIPAL={"user_id":"dev-user","tenant_id":"dev-tenant","roles":["rag.admin"],"groups":[],"email":"dev@example.com","display_name":"Dev User","max_classification":"restricted"}
